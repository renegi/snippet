{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix snippet/server --omit=dev && npm ci --prefix snippet/client",
  "buildCommand": "npm run build --prefix snippet/client",
  "outputDirectory": "snippet/client/build",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
